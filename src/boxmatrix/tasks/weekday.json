{
  "id": "weekday",
  "title": "Day of week without datetime",
  "suite": "hard",
  "prompt": "Write `weekday(y, m, d)` returning the day of the week for a Gregorian date as an int, 0=Monday ... 6=Sunday. Do not import datetime or calendar.",
  "entrypoint": "weekday",
  "cases": [
    {
      "args": [
        2024,
        1,
        1
      ],
      "expected": 0
    },
    {
      "args": [
        2000,
        2,
        29
      ],
      "expected": 1
    },
    {
      "args": [
        1900,
        3,
        1
      ],
      "expected": 3
    },
    {
      "args": [
        2026,
        11,
        15
      ],
      "expected": 6
    },
    {
      "args": [
        1970,
        1,
        1
      ],
      "expected": 3
    },
    {
      "args": [
        2100,
        12,
        31
      ],
      "expected": 4
    },
    {
      "args": [
        2023,
        7,
        4
      ],
      "expected": 1
    }
  ],
  "reference": "def weekday(y, m, d):\n    t = [0, 3, 2, 5, 0, 3, 5, 1, 4, 6, 2, 4]\n    if m < 3:\n        y -= 1\n    sun0 = (y + y // 4 - y // 100 + y // 400 + t[m - 1] + d) % 7\n    return (sun0 - 1) % 7\n"
}
